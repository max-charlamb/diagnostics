<Project>
  <!--
    Directory.Build.props for IDE IntelliSense support.
    Actual debuggee builds happen from artifacts/ with isolated props.
  -->

  <!-- Import the repo root props for IDE support -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Debuggee-specific settings that override repo defaults -->
  <PropertyGroup>
    <EnableAnalyzers>false</EnableAnalyzers>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>false</Optimize>
  </PropertyGroup>
</Project>
