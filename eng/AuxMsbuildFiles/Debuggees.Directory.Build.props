<Project>
  <!-- 
    Isolated Directory.Build.props for debuggee builds.
    This file is copied to artifacts/test/DebuggeeSources/ and provides
    complete isolation from the main repo's build infrastructure.
  -->

  <!-- Block any parent Directory.Build.props/targets imports -->
  <PropertyGroup>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>

  <!-- Required target framework properties -->
  <PropertyGroup>
    <SupportedSubProcessTargetFrameworks>net8.0;net9.0;net10.0</SupportedSubProcessTargetFrameworks>
    <DesktopTargetFramework>net462</DesktopTargetFramework>
    <NetCoreAppMinTargetFramework>net8.0</NetCoreAppMinTargetFramework>
  </PropertyGroup>

  <!-- Output paths - build outputs go to artifacts/bin/<DebuggeeName>/<Config>/<TFM>/ -->
  <PropertyGroup>
    <ArtifactsDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</ArtifactsDir>
    <BaseOutputPath>$(ArtifactsDir)bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <!-- Debuggee-specific build settings -->
  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableAnalyzers>false</EnableAnalyzers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <!-- Package versions for debuggees that need them -->
  <PropertyGroup>
    <MicrosoftExtensionsLoggingEventSourceVersion>5.0.1</MicrosoftExtensionsLoggingEventSourceVersion>
  </PropertyGroup>
</Project>
